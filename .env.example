# Neon (or any Postgres) connection string, free tier.
# Create a project at https://neon.tech, then paste the connection string here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The site's own canonical URL — used to build metadata, sitemap.xml and JSON-LD.
# Defaults to https://odishabizhub.com if unset (see lib/site-config.ts).
NEXT_PUBLIC_SITE_URL=https://odishabizhub.com

# Razorpay — chosen payment gateway (2026-08-31), not yet wired to a live checkout.
# There's no priced product on the site yet (Phase 2's self-serve intake form isn't
# built), so these are placeholders for when that exists. Use TEST keys until then.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
